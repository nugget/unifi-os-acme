# ---------------------------------------------------------------- certificate
# Names on the certificate, space or comma separated. The first is the primary
# name and, unless DEPLOY_UNIFI_OS_HOST says otherwise, the console's address.
ACME_DOMAINS=unifi.example.com

# Contact address for the ACME account. Used for expiry warnings.
ACME_EMAIL=you@example.com

# CA to use: letsencrypt, letsencrypt_test, zerossl, buypass, google.
# Point this at letsencrypt_test while you get the setup working - the staging
# CA issues untrusted certificates but has far looser rate limits.
#ACME_SERVER=letsencrypt

# Key type. RSA 2048 is the default for maximum client compatibility; ec-256
# works on current UniFi OS and produces a smaller, faster certificate.
#ACME_KEYLENGTH=2048

# ------------------------------------------------------------------- DNS-01
# The acme.sh DNS provider for your domain. Full list:
# https://github.com/acmesh-official/acme.sh/wiki/dnsapi
ACME_DNS_PROVIDER=dns_cf

# Your provider's credentials, named exactly as acme.sh expects. Whatever you
# put here is passed through to it. Examples:
#CF_Token=...
#LINODE_V4_API_KEY=...
#AWS_ACCESS_KEY_ID=...
#AWS_SECRET_ACCESS_KEY=...

# --------------------------------------------------------- propagation gate
# Wait until every authoritative nameserver for the zone serves the challenge
# record before asking the CA to validate. Fixes intermittent failures on
# providers that publish to their nameservers at different times. See the
# README section "The propagation gate" for why the usual check is not enough.
#ACME_NS_GATE=1

# Seconds to wait for full propagation before giving up and retrying later.
#ALLNS_TIMEOUT=1800

# Seconds between polls.
#ALLNS_INTERVAL=20

# Nameservers to poll. Discovered from the zone's NS records by default; set
# this if discovery gets the wrong answer, e.g. behind a split-horizon resolver.
#ALLNS_SERVERS=ns1.example.net,ns2.example.net

# Resolver used for zone and NS discovery. Defaults to the system resolver; set
# a public one if yours returns an internal view of the zone.
#ALLNS_RESOLVER=1.1.1.1

# Only used when ACME_NS_GATE=0: acme.sh's own fixed wait, in seconds.
#ACME_DNSSLEEP=

# ------------------------------------------------------------------- console
# Hostname or IP of the UniFi OS console. Defaults to the primary name above.
# May include a port, e.g. unifi.example.com:8443.
#DEPLOY_UNIFI_OS_HOST=unifi.example.com

# A console admin with Account Type "Local Access Only" and MFA disabled.
# A Ubiquiti SSO account cannot authenticate against the local API.
DEPLOY_UNIFI_OS_USER=acme
DEPLOY_UNIFI_OS_PASSWORD=

# Name prefix for certificates this tool uploads. It only ever deletes entries
# carrying this prefix, so anything you uploaded by hand is left alone.
#DEPLOY_UNIFI_OS_NAME=acme.sh

# Set to 1 to keep superseded certificates instead of deleting them.
#DEPLOY_UNIFI_OS_KEEP_OLD=0

# Verify the console's own TLS certificate when talking to it. Off by default,
# because on the first run the console is still presenting its self-signed
# certificate. The install is verified by fingerprint regardless.
#DEPLOY_UNIFI_OS_VERIFY=0

# -------------------------------------------------------------------- misc
# Run one issue/renew pass and exit, instead of staying up as a daemon. For
# use with an external scheduler.
#RUN_ONCE=0

# Seconds to pause before exiting after a fatal error, so restart loops stay
# readable in the logs.
#ACME_RETRY_DELAY=300

# Extra arguments appended to acme.sh --issue.
#ACME_EXTRA_ARGS=
